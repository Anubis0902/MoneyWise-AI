# .streamlit/secrets.toml.template
#
# ══════════════════════════════════════════════════════════════════════════════
# SETUP INSTRUCTIONS
# ══════════════════════════════════════════════════════════════════════════════
# LOCAL DEVELOPMENT
#   1. Copy this file:  cp .streamlit/secrets.toml.template .streamlit/secrets.toml
#   2. Fill in real values below
#   3. secrets.toml is git-ignored — NEVER commit it
#
# STREAMLIT CLOUD DEPLOYMENT
#   App Settings → Secrets → paste key = "value" pairs (one per line)
#   Include ALL keys from this template that apply to your setup.
# ══════════════════════════════════════════════════════════════════════════════

# ── AI API Keys ───────────────────────────────────────────────────────────────
# Groq: free tier available at https://console.groq.com
GROQ_API_KEY    = "gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# NVIDIA NIM (optional — only needed if you use NVIDIA-based models)
NVIDIA_API_KEY  = "nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ── GitHub DB Backup ──────────────────────────────────────────────────────────
# Step 1: Create a Personal Access Token (PAT) with "repo" scope:
#         https://github.com/settings/tokens/new
#         Token name: "moneywise-db-backup"
#         Expiration: 1 year (or No expiration)
#         Scopes:     ✅ repo  (full control of private repositories)
GITHUB_TOKEN    = "ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Step 2: Create a NEW private GitHub repo for backup storage.
#         e.g. github.com/yourusername/moneywise-db-backup
#         It can be completely empty — backup will create the file.
GITHUB_REPO     = "yourusername/moneywise-db-backup"

# Step 3: File path inside that repo (keep this value exactly as-is)
GITHUB_DB_PATH  = "MoneyWise.db"

# Step 4: Branch to read/write (must exist — GitHub creates "main" by default)
GITHUB_BRANCH   = "main"

# ── GitHub Actions Secrets (set in repo Settings → Secrets → Actions) ────────
# The following are NOT in secrets.toml — they go directly into GitHub Secrets.
# They are listed here for reference only.
#
#   STREAMLIT_APP_URL      Full URL of your Streamlit Cloud app
#                          e.g. https://yourusername-moneywise-ai-app-xyz.streamlit.app
#                          Used by: keep_alive.yml (Playwright keep-alive)
#
#   BACKUP_GITHUB_TOKEN    Same PAT as GITHUB_TOKEN above, or a separate one
#                          Used by: db_backup.yml (health check)
#
#   BACKUP_GITHUB_REPO     Same as GITHUB_REPO above
#                          Used by: db_backup.yml (health check)
